{
	"name": "obsidian-tasks-table",
	"version": "0.3.0",
	"description": "Tasks from every note in one table with saved views, filters, sorting and columns.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test:e2e": "npm run build && node e2e/smoke.mjs",
		"e2e:open": "node e2e/launch.mjs",
		"screenshot": "npm run build && node e2e/screenshot.mjs"
	},
	"keywords": [
		"obsidian",
		"tasks",
		"table"
	],
	"license": "0-BSD",
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@tanstack/react-query": "5.105.0",
		"@tanstack/react-store": "0.11.2",
		"@tanstack/react-table": "9.3.1",
		"@tanstack/react-virtual": "3.14.24",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.66.0",
		"react": "19.3.1",
		"react-day-picker": "10.0.2",
		"react-dom": "19.3.1",
		"sql.js": "1.15.2",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "^22.15.17",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sql.js": "^1.4.9",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"playwright-core": "^1.64.1",
		"postcss": "^8.5.6",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "5.0.5"
	}
}
